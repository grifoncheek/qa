    {
      "name": "02. Booking — CRUD",
      "item": [
        {
          "name": "POST /booking — создать бронь",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('clientLastName', 'QA-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const expectedLastName = pm.environment.get('clientLastName');",
                  "",
                  "pm.test('Статус 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Возвращён числовой bookingid', function () {",
                  "    pm.expect(body.bookingid).to.be.a('number').and.above(0);",
                  "});",
                  "",
                  "pm.test('Данные брони совпадают с запросом', function () {",
                  "    pm.expect(body.booking.firstname).to.eql('QA');",
                  "    pm.expect(body.booking.lastname).to.eql(expectedLastName);",
                  "    pm.expect(body.booking.totalprice).to.eql(1500);",
                  "    pm.expect(body.booking.depositpaid).to.eql(true);",
                  "    pm.expect(body.booking.bookingdates).to.include({ checkin: '2026-12-01', checkout: '2026-12-05' });",
                  "});",
                  "",
                  "pm.test('Ответ пришёл быстрее 5 секунд', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "",
                  "pm.environment.set('bookingId', body.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"QA\",\n  \"lastname\": \"{{clientLastName}}\",\n  \"totalprice\": 1500,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-12-01\",\n    \"checkout\": \"2026-12-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": ["{{baseUrl}}"],
              "path": ["booking"]
            }
          },
          "response": []
        },
        {
          "name": "GET /booking — список броней",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Статус 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Получен непустой массив bookingid', function () {",
                  "    pm.expect(body).to.be.an('array').and.not.empty;",
                  "    pm.expect(body[0]).to.have.property('bookingid');",
                  "});",
                  "",
                  "pm.test('Созданная бронь присутствует в списке', function () {",
                  "    const ids = body.map(function (item) { return item.bookingid; });",
                  "    pm.expect(ids).to.include(Number(pm.environment.get('bookingId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": ["{{baseUrl}}"],
              "path": ["booking"]
